# Copy this file to .env.local and fill in your OWN Supabase project's values.
# Never commit .env.local or any file containing real credentials.
# These are PLACEHOLDERS ONLY — do not paste real values into this file.

# Supabase project URL (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=your-project-url

# Supabase anon/public key (safe for client-side use, Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SUPABASE_SERVICE_ROLE_KEY is intentionally NOT listed here yet.
# Nothing in the codebase uses it — it bypasses all RLS policies, so it
# must only be added when a specific server-only feature actually needs
# it (e.g. a transactional order-placement function), never for routine
# use, and never in any code that ships to the browser.
